          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "consumer_principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "effect_actor_principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "target_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "grant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "authorization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tenant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "job": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "recipient": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "root_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "subject_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "request_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "context_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "grant_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "authorization_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
